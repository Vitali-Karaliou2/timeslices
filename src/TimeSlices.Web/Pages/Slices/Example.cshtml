@page "/slices/{id}/examples/{exampleId}"
@model TimeSlices.Web.Pages.Slices.ExampleModel
@{
    ViewData["Title"] = Model.Example.Title;
    var impl = Model.Implementation;
}

<p><a asp-page="/Slices/Slice" asp-route-id="@Model.Slice.Id" asp-route-track="@Model.TrackId">← @Model.Slice.Title</a></p>
<h1>@Model.Example.Title</h1>
<p>@DraftMark.BadgeFor(Model.Example.Task)@DraftMark.Strip(Model.Example.Task)</p>

<form method="get">
    <input type="hidden" name="track" value="@Model.TrackId" />
    <label>
        Реализация:
        <select name="impl" data-autosubmit>
            @foreach (var i in Model.Implementations)
            {
                var title = Model.Catalog.Slices.TryGetValue(i.Slice, out var s) ? s.Title : i.Slice;
                <option value="@i.Id" selected="@(i.Id == impl.Id)">@i.Id — @i.Stack (@title)</option>
            }
        </select>
    </label>
    <noscript><button type="submit">Показать</button></noscript>
</form>

<p>
    Стек: @impl.Stack · код: @(impl.CodeMode == "emulated" ? "эмулируемый" : "исполняемый непосредственно")
    @if (impl.AnachronismCheck?.By != "human")
    {
        <span class="draft">· проверка на анахронизмы человеком не проведена</span>
    }
</p>

@* sandbox без allow-same-origin: пример изолирован от оболочки (cookie, DOM родителя). *@
<iframe class="implementation" src="@Model.EntryUrl" sandbox="allow-scripts allow-forms" title="@Model.Example.Title — @impl.Id"></iframe>

<h2>Код для показа</h2>
@if (Model.Code.Count == 0)
{
    <p>Нет файлов кода для показа.</p>
}
@for (var c = 0; c < Model.Code.Count; c++)
{
    var (file, lines) = Model.Code[c];
    <h3 id="code-@c">@file.Path</h3>
    @if (!string.IsNullOrEmpty(file.Note))
    {
        <p>@DraftMark.BadgeFor(file.Note)@DraftMark.Strip(file.Note)</p>
    }
    @* data-code-file: отсюда проигрыватель берёт фрагмент для стоп-кадра. *@
    <pre class="code" data-code-file="@file.Path">@for (var n = 0; n < lines.Length; n++)
{<span class="line" id="code-@c-L@(n + 1)"><span class="ln">@(n + 1)</span>@lines[n]</span>}</pre>
}

<h2>Процессы</h2>
@if (impl.Processes.Count == 0)
{
    <p>Процессов нет.</p>
}
@foreach (var pr in impl.Processes)
{
    <section class="process" data-process-player>
    <h3>@pr.Id (@(pr.Type == "creation" ? "процесс создания" : "процесс исполнения")@(pr.Process?.Variant is { } v ? ", вариант " + v : ""))</h3>
    @if (pr.Process is not null)
    {
        var steps = Model.Schedules[pr.Id];
        @* Проигрыватель скрыт, пока его не включит process-player.js; без JS виден только список кадров. *@
        <div class="player" hidden>
            <div class="player-clock">
                <span class="player-time">&nbsp;</span>
                <span class="player-gap"></span>
            </div>
            <div class="player-progress"><div class="player-progress-bar"></div></div>
            <div class="player-controls">
                <button type="button" data-action="play">Проиграть</button>
                <button type="button" data-action="pause" disabled>Пауза</button>
                <button type="button" data-action="back">Назад</button>
                <button type="button" data-action="forward">Вперёд</button>
                <label>Скорость
                    <select data-action="speed">
                        <option value="1">×1</option>
                        <option value="2">×2</option>
                        <option value="4">×4</option>
                    </select>
                </label>
            </div>
            <p class="player-status" aria-live="polite"></p>
            <div class="player-stop" hidden>
                <p class="player-stop-explanation" id="stop-explanation-@pr.Id"></p>
                <p class="player-stop-refs refs" hidden></p>
                <p class="player-stop-file"></p>
                <pre class="code player-stop-code"></pre>
                <button type="button" data-action="continue" aria-describedby="stop-explanation-@pr.Id">Дальше</button>
            </div>
        </div>
        <ol class="frames">
            @foreach (var step in steps)
            {
                <li class="@(step.Stop ? "frame-stop" : "")" data-order="@step.Order">
                    @DraftMark.Badge(step.Draft)
                    @if (step.AtDisplay is { } at) { <span class="frame-at">@at — </span> }
                    @step.Text
                    @if (step.DurationNote is { } note) { <span> (@note)</span> }
                    @if (step.Stop)
                    {
                        <span>[стоп-кадр]</span>
                        @if (step.Detail is { } d)
                        {
                            var codeIndex = Model.CodeIndexOf(d.CodeFile);
                            <div class="frame-detail">
                                @if (codeIndex >= 0)
                                {
                                    <a href="#code-@codeIndex-L@(d.LineFrom ?? 1)">@d.CodeFile, строки @d.Lines</a>
                                }
                                else
                                {
                                    <span>@d.CodeFile @d.Lines</span>
                                }
                                @* Пояснение в списке — только без JS: с проигрывателем оно показывается один раз, в панели стоп-кадра. *@
                                @if (d.Explanation is { } explanation) { <span class="frame-explanation">— @explanation</span> }
                                @* Ссылки на справку — так же: без JS в списке, с проигрывателем — в панели стоп-кадра. *@
                                @if (d.Refs is { } refs)
                                {
                                    <span class="frame-refs">Справка:
                                        @for (var r = 0; r < refs.Count; r++)
                                        {
                                            <a href="@refs[r].Href" target="_blank" rel="noopener">@refs[r].Label</a>@(r + 1 < refs.Count ? ", " : "")
                                        }
                                    </span>
                                }
                            </div>
                        }
                    }
                </li>
            }
        </ol>
        <script type="application/json" class="process-schedule">@Html.Raw(Model.ScheduleJson(pr.Id))</script>
    }
    </section>
}

@section Scripts {
    <script src="~/js/process-player.js" asp-append-version="true"></script>
}
