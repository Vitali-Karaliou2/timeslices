<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TimeSlices</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a asp-area="" asp-page="/Index"><strong>TimeSlices</strong></a>
            @* Справка открыта и без входа (ADR 0013, п. 8). *@
            <a asp-area="" asp-page="/Reference/Index">Справка</a>
            @if (User.IsInRole(Roles.Examiner) || User.IsInRole(Roles.Admin))
            {
                <a asp-area="" asp-page="/Examiner/Index">Сдачи</a>
            }
            @if (User.IsInRole(Roles.Admin))
            {
                <a asp-area="" asp-page="/Admin/Index">Администрирование</a>
            }
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
