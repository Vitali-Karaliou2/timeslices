@inject SignInManager<ApplicationUser> SignInManager

<span class="login">
@if (SignInManager.IsSignedIn(User))
{
    <a asp-area="Identity" asp-page="/Account/Manage/Index">@User.Identity?.Name</a>
    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
        <button type="submit">Выйти</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    <a asp-area="Identity" asp-page="/Account/Login">Вход</a>
}
</span>
