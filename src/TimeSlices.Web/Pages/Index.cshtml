@page
@model IndexModel
@{
    ViewData["Title"] = "Треки и срезы";
}

<h1>Треки и срезы</h1>

@foreach (var track in Model.Catalog.Tracks)
{
    <section>
        <h2>@track.Title</h2>
        @if (!string.IsNullOrEmpty(track.Description))
        {
            <p>@DraftMark.BadgeFor(track.Description)@DraftMark.Strip(track.Description)</p>
        }
        <ol>
            @foreach (var key in Model.Catalog.SlicesInTrack(track.Id))
            {
                var slice = Model.Catalog.Slices[key.SliceId];
                var status = Model.Statuses[key];
                <li>
                    @if (status.State == SliceState.Unavailable)
                    {
                        <span class="locked">@slice.Title</span>
                    }
                    else
                    {
                        <a asp-page="/Slices/Slice" asp-route-id="@slice.Id" asp-route-track="@track.Id">@slice.Title</a>
                    }
                    <span>(@slice.YearFrom–@slice.YearTo)</span>
                    <span class="state state-@status.State">@Labels.State(status)</span>
                    @if (Model.Attempts.TryGetValue(key, out var attempt))
                    {
                        <span class="state submission submission-@attempt.Status">@Labels.Submission(attempt.Status)</span>
                    }
                </li>
            }
        </ol>
    </section>
}
